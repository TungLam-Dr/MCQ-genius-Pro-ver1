{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/share/:path*",
      "destination": "/api/index?share=1&path=:path*"
    },
    {
      "source": "/api/gemini/:action",
      "destination": "/api/index?action=:action"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
